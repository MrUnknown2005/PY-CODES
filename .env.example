# Copy this file to ".env" and fill in your values. The .env file is git-ignored.

# Required: your free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional settings (defaults shown)
GEMINI_MODEL=gemini-3.6-flash
# 0 = no "thinking" before replies = much faster. Raise (e.g. 512) for harder
# reasoning; -1 to omit entirely for models that don't support it.
GEMINI_THINKING_BUDGET=0
CONFIRM_DESTRUCTIVE=true
MAX_STEPS=10

# Voice (optional)
VOICE_OUTPUT=false
# ".en" models are English-only: faster AND more accurate for English commands.
# Options: tiny.en | base.en | small.en (or multilingual: tiny | base | small ...)
WHISPER_MODEL=base.en
# Decoding beam size: 1 = greedy = fastest. Higher is slower, marginally better.
WHISPER_BEAM=1
# int8 (fast) | int8_float32 | float32 (slow). 0 threads = auto (all cores).
WHISPER_COMPUTE=int8
WHISPER_THREADS=0
# Wake phrase for hands-free mode (python main.py --wake)
WAKE_WORD=hey darling
# Pause length (s) that ends a spoken command; mic loudness floor for silence.
SILENCE_DURATION=0.8
SILENCE_THRESHOLD=0.015

# Logging
LOG_FILE=assistant.log
